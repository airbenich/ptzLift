# Copy to .env and fill with your local credentials
WIFI_SSID=your-wifi-ssid
WIFI_PASSWORD=your-wifi-password
WIFI_AP_SSID=ptzpedestal-local

# ESP32 DevKitC V4 (official) usually has only a fixed 5V power LED.
# Keep -1 to disable status LED control. Set to a GPIO (e.g. 2) only on boards that expose a controllable LED.
STATUS_LED_PIN=-1
# 1 for active-high LED, 0 for active-low LED.
STATUS_LED_ACTIVE_HIGH=1
